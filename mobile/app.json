{
  "expo": {
    "name": "Clean Life ERP",
    "slug": "clean-life-erp",
    "owner": "shoxrux007",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.cleanlife.erp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Davomat uchun joylashuvingiz tekshiriladi.",
        "NSFaceIDUsageDescription": "Davomatni tasdiqlash uchun Face ID ishlatiladi."
      }
    },
    "android": {
      "package": "uz.cleanlife.erp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#121110",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#121110"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Davomat uchun joylashuvingiz tekshiriladi."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Davomatni tasdiqlash uchun Face ID ishlatiladi."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e08b4f2f-11ab-4777-b4dd-bc1e05895687"
      }
    }
  }
}
